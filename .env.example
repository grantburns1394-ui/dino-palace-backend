
# Copy this file to .env and fill in the values

# Where the backend is hosted, e.g. https://dino-palace-backend.onrender.com
BACKEND_BASE_URL=https://YOUR_BACKEND_URL

# Where the frontend (Netlify) site lives, e.g. https://dinopalace.netlify.app
FRONTEND_ORIGIN=https://YOUR_FRONTEND_URL

# Your public Steam API key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=YOUR_STEAM_API_KEY

# Any random string
SESSION_SECRET=super-secret-session-string

# The Isle server info
SERVER_HOST=104.37.188.86
SERVER_PORT=27048
# Gamedig type; if "theisle" doesn't work, protocol-valve usually does
SERVER_TYPE=protocol-valve
